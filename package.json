{
  "name": "dsh-musee",
  "version": "0.6.2",
  "description": "Musée — read journals and preprints inside DeepSeek Harness, with academic translation, citations, and reading notes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuhang-Wan/musee.git"
  },
  "homepage": "https://github.com/Yuhang-Wan/musee#readme",
  "bugs": {
    "url": "https://github.com/Yuhang-Wan/musee/issues"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "papers",
    "journals",
    "arxiv",
    "academic"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/pdf.worker.min.mjs",
    "assets/pdf.min.mjs",
    "src/host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
